LUMACORE_HOST=0.0.0.0
LUMACORE_PORT=3000

LUMACORE_DEFAULT_MODEL=lumacore-4.0
LUMACORE_MAX_FILE_MB=50

# Codespace development mode.
# true = instant response without loading the local ML model
# false = use the actual LumaCore model
LUMACORE_FAST_MODE=true

# Development checkpoints
LUMACORE_3_2_CHECKPOINT=Qwen/Qwen2.5-0.5B-Instruct
LUMACORE_4_0_CHECKPOINT=Qwen/Qwen2.5-0.5B-Instruct
LUMACORE_5_7_CHECKPOINT=Qwen/Qwen2.5-0.5B-Instruct

# Optional Hugging Face authentication
# Leave empty for public models.
HF_TOKEN=