# LumaCore server
LUMACORE_HOST=0.0.0.0
LUMACORE_PORT=3000
LUMACORE_FAST_MODE=false
LUMACORE_MAX_FILE_MB=50

# Text checkpoints
LUMACORE_3_2_CHECKPOINT=Qwen/Qwen2.5-0.5B-Instruct
LUMACORE_4_0_CHECKPOINT=Qwen/Qwen2.5-0.5B-Instruct
LUMACORE_5_7_CHECKPOINT=Qwen/Qwen2.5-0.5B-Instruct

# Local image/video generation checkpoints.
# Models are downloaded lazily the first time they are used.
LUMACORE_IMAGE_MODEL=runwayml/stable-diffusion-v1-5
LUMACORE_VIDEO_MODEL=THUDM/CogVideoX-2b
